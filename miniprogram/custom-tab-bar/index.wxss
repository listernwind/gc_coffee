@import "../assets/icons.wxss";
.tab-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 110rpx;
  background: rgba(46, 33, 24, 0.96);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(46, 33, 24, 0.35);
  z-index: 100;
  padding: 0 16rpx;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(255, 247, 236, 0.55);
  border-radius: 44rpx;
  height: 92rpx;
  transition: all 0.2s;
}
.tab-item.active {
  color: #FFF7EC;
  background: linear-gradient(135deg, #D9A05B, #B8783D);
}
.tab-icon { width: 38rpx; height: 38rpx; }
.tab-text { font-size: 20rpx; margin-top: 2rpx; }
