.pickup-card {
  background: linear-gradient(135deg, #6F4E37 0%, #4B3621 100%);
  border-radius: 32rpx;
  padding: 48rpx 0;
  text-align: center;
  color: #FFF7EC;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(75, 54, 33, 0.25);
}
.pc-label { font-size: 26rpx; opacity: 0.8; }
.pc-code {
  font-size: 110rpx;
  font-weight: 800;
  letter-spacing: 16rpx;
  margin: 10rpx 0;
  font-family: "SF Mono", Menlo, monospace;
}
.pc-tip { font-size: 22rpx; opacity: 0.65; }
