.dates { white-space: nowrap; margin-bottom: 16rpx; }
.date-chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: #FFF;
  font-size: 24rpx;
  margin-right: 14rpx;
  color: var(--ink-2);
}
.date-chip.sel { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.statuses { white-space: nowrap; margin-bottom: 20rpx; }
.status-chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #F1E9DE;
  font-size: 22rpx;
  margin-right: 12rpx;
  color: var(--ink-2);
}
.status-chip.sel { background: #F3E7D8; color: #A06A2E; font-weight: 700; }

.rv-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.rv-product { font-weight: 700; font-size: 30rpx; }
.rv-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 24rpx; }
.rv-row .label { color: var(--ink-2); flex-shrink: 0; margin-right: 16rpx; }
.rv-row .value { text-align: right; }
.rv-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 16rpx; }
