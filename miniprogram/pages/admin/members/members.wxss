.search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-input {
  flex: 1;
  background: #FFF;
  border-radius: 999rpx;
  padding: 18rpx 30rpx;
  font-size: 26rpx;
}
.search-btn {
  background: var(--coffee);
  color: #FFF7EC;
  border-radius: 999rpx;
  padding: 18rpx 36rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.m-head { display: flex; justify-content: space-between; align-items: center; }
.m-actions { display: flex; gap: 18rpx; }
.op { font-size: 24rpx; color: var(--accent); }
.op.danger { color: var(--danger); }
.op.ok { color: var(--ok); }

.m-stats { display: flex; margin-top: 20rpx; background: #FAF6F0; border-radius: 18rpx; padding: 18rpx 0; }
.ms { flex: 1; text-align: center; }
.ms-num { font-size: 28rpx; font-weight: 800; color: var(--coffee); }
.ms-label { font-size: 20rpx; color: var(--ink-2); }
