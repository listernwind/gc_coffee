.tabs {
  display: flex;
  background: #FFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: var(--ink-2); border-radius: 999rpx; }
.tab.active { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.a-head { display: flex; justify-content: space-between; align-items: center; }
.a-type { background: #F3E7D8; color: #A06A2E; font-size: 20rpx; border-radius: 999rpx; padding: 4rpx 16rpx; }
.a-ops { display: flex; gap: 24rpx; margin-top: 14rpx; }
.op { font-size: 24rpx; color: var(--accent); }
.op.danger { color: var(--danger); }

.prow { display: flex; align-items: center; }
.p-ic { width: 36rpx; height: 36rpx; margin-right: 12rpx; }

