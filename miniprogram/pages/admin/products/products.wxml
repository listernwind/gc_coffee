<view class="page page-pad">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{activeTab === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="switchTab">{{item.label}}</view>
  </view>

  <!-- 饮品分类条 -->
  <view class="cat-bar" wx:if="{{activeTab === 'drink'}}">
    <view class="cat-chip" wx:for="{{categories}}" wx:key="id">{{item.name}}</view>
    <view class="cat-add" bindtap="addCategory">＋分类</view>
  </view>

  <!-- 饮品列表 -->
  <block wx:if="{{activeTab === 'drink'}}">
    <view class="card row" wx:for="{{drinkProducts}}" wx:key="id">
      <view>
        <view style="font-weight:700;">{{item.name}} <text class="sub" wx:if="{{item.active !== 1}}">（已下架）</text></view>
        <view class="sub">¥{{item.price}} · {{item.tags}}</view>
      </view>
      <view class="ops">
        <view class="op" data-item="{{item}}" bindtap="openForm">编辑</view>
        <view class="op danger" data-id="{{item.id}}" bindtap="remove">删除</view>
      </view>
    </view>
  </block>

  <!-- 咖啡液列表 -->
  <block wx:if="{{activeTab === 'coffee'}}">
    <view class="card row" wx:for="{{coffeeProducts}}" wx:key="id">
      <view>
        <view style="font-weight:700;">{{item.name}} <text class="sub" wx:if="{{item.active !== 1}}">（已下架）</text></view>
        <view class="sub">¥{{item.price}} · {{item.spec}}</view>
      </view>
      <view class="ops">
        <view class="op" data-item="{{item}}" bindtap="openForm">编辑</view>
        <view class="op danger" data-id="{{item.id}}" bindtap="remove">删除</view>
      </view>
    </view>
  </block>

  <!-- 套餐列表 -->
  <block wx:if="{{activeTab === 'package'}}">
    <view class="card row" wx:for="{{packages}}" wx:key="id">
      <view>
        <view style="font-weight:700;">{{item.name}} <text class="sub" wx:if="{{item.active !== 1}}">（已下架）</text></view>
        <view class="sub">¥{{item.price}} / 月 · {{item.bottleCount}}瓶</view>
      </view>
      <view class="ops">
        <view class="op" data-item="{{item}}" bindtap="openForm">编辑</view>
        <view class="op danger" data-id="{{item.id}}" bindtap="remove">删除</view>
      </view>
    </view>
  </block>

  <button class="btn btn-primary" bindtap="openForm">＋ 新增{{activeTab === 'drink' ? '饮品' : activeTab === 'coffee' ? '咖啡液' : '套餐'}}</button>

  <!-- 编辑弹层 -->
  <view class="mask" wx:if="{{showForm}}" bindtap="closeForm"></view>
  <view class="sheet" wx:if="{{showForm}}">
    <view class="sheet-title">{{editing ? '编辑' : '新增'}}{{kind === 'drink' ? '饮品' : kind === 'coffee' ? '咖啡液' : '套餐'}}</view>

    <view class="form-item" wx:if="{{kind === 'drink'}}">
      <text class="label">分类</text>
      <picker range="{{categories}}" range-key="name" value="{{form.categoryIndex}}" bindchange="onCategory">
        <view class="input">{{categories[form.categoryIndex] ? categories[form.categoryIndex].name : '请选择'}}</view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">名称</text>
      <input class="input" value="{{form.name}}" data-field="name" bindinput="onField" placeholder="商品名称" />
    </view>
    <view class="form-item" wx:if="{{kind === 'drink'}}">
      <text class="label">描述</text>
      <input class="input" value="{{form.descText}}" data-field="descText" bindinput="onField" />
    </view>
    <view class="form-item" wx:if="{{kind === 'drink'}}">
      <text class="label">标签（逗号分隔，如 热,冰）</text>
      <input class="input" value="{{form.tagsText}}" data-field="tagsText" bindinput="onField" />
    </view>
    <view class="form-item" wx:if="{{kind === 'drink'}}">
      <text class="label">库存（-1 不限）</text>
      <input class="input" type="number" value="{{form.stock}}" data-field="stock" bindinput="onField" />
    </view>
    <view class="form-item" wx:if="{{kind === 'coffee'}}">
      <text class="label">规格（如 500ml/瓶）</text>
      <input class="input" value="{{form.spec}}" data-field="spec" bindinput="onField" />
    </view>
    <view class="form-item" wx:if="{{kind === 'coffee'}}">
      <text class="label">描述</text>
      <input class="input" value="{{form.descText}}" data-field="descText" bindinput="onField" />
    </view>
    <view class="form-item" wx:if="{{kind === 'package'}}">
      <text class="label">每月瓶数</text>
      <input class="input" type="number" value="{{form.bottleCount}}" data-field="bottleCount" bindinput="onField" />
    </view>
    <view class="form-item">
      <text class="label">价格（元）</text>
      <input class="input" type="digit" value="{{form.price}}" data-field="price" bindinput="onField" />
    </view>
    <view class="form-item">
      <text class="label">排序</text>
      <input class="input" type="number" value="{{form.sort}}" data-field="sort" bindinput="onField" />
    </view>
    <view class="form-item">
      <text class="label">上架</text>
      <switch checked="{{form.active === 1}}" color="#C08A4E" data-field="active" bindchange="onSwitch" />
    </view>
    <button class="btn btn-primary" bindtap="save">保存</button>
  </view>
</view>
