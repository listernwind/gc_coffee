.tabs {
  display: flex;
  background: #FFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: var(--ink-2); border-radius: 999rpx; }
.tab.active { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.cat-bar { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.cat-chip { background: #FFF; border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 22rpx; color: var(--ink-2); }
.cat-add { background: #F3E7D8; color: #A06A2E; border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 22rpx; font-weight: 700; }

.ops { display: flex; gap: 14rpx; }
.op { font-size: 24rpx; color: var(--accent); }
.op.danger { color: var(--danger); }
