.types { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.type-chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #FAF6F0;
  font-size: 24rpx;
  color: var(--ink-2);
}
.type-chip.sel { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.dates { display: flex; align-items: center; gap: 14rpx; }
.date-box {
  background: #FAF6F0;
  border-radius: 14rpx;
  padding: 14rpx 20rpx;
  font-size: 24rpx;
}
.to { color: var(--ink-3); }
.export {
  margin-left: auto;
  background: #F3E7D8;
  color: #A06A2E;
  font-size: 24rpx;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-weight: 700;
}

.summary { display: flex; background: linear-gradient(135deg, #6F4E37, #4B3621); border-radius: 24rpx; padding: 26rpx 0; color: #FFF7EC; margin-bottom: 24rpx; }
.sm-item { flex: 1; text-align: center; }
.sm-num { font-size: 36rpx; font-weight: 800; }
.sm-label { font-size: 20rpx; opacity: 0.7; }

.lg-head { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.lg-type {
  background: #F3E7D8;
  color: #A06A2E;
  font-size: 22rpx;
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  font-weight: 700;
}
.lg-status { font-size: 22rpx; color: var(--ink-2); }
.lg-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 24rpx; }
.lg-row .label { color: var(--ink-2); flex-shrink: 0; margin-right: 20rpx; }
.lg-row .value { text-align: right; word-break: break-all; }
