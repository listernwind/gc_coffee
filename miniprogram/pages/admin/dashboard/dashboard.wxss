.dash { padding: 0 28rpx 60rpx; }

.dash-top {
  background: linear-gradient(160deg, #4B3621 0%, #6F4E37 100%);
  margin: 0 -28rpx;
  padding: 60rpx 32rpx 120rpx;
  border-radius: 0 0 48rpx 48rpx;
  color: #FFF7EC;
}
.dash-head { display: flex; justify-content: space-between; align-items: center; }
.dash-title { font-size: 40rpx; font-weight: 800; }
.dash-date { font-size: 22rpx; opacity: 0.7; margin-top: 4rpx; }
.dash-exit { font-size: 24rpx; background: rgba(255,255,255,0.15); border-radius: 999rpx; padding: 10rpx 26rpx; }
.big-card { margin-top: 36rpx; }
.bc-label { font-size: 24rpx; opacity: 0.75; }
.bc-num { font-size: 76rpx; font-weight: 800; margin: 6rpx 0; }
.bc-sub { font-size: 22rpx; opacity: 0.65; }

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: -70rpx;
  margin-bottom: 24rpx;
}
.stat {
  width: calc(33.33% - 14rpx);
  box-sizing: border-box;
  background: #FFF;
  border-radius: 24rpx;
  padding: 26rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(75, 54, 33, 0.08);
}
.s-num { font-size: 38rpx; font-weight: 800; color: var(--coffee); }
.s-label { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }

.card-title { font-weight: 700; font-size: 30rpx; margin-bottom: 24rpx; }

.bars { display: flex; align-items: flex-end; gap: 8rpx; height: 180rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; }
.bar {
  width: 100%;
  max-width: 28rpx;
  background: linear-gradient(180deg, #D9A05B, #B8783D);
  border-radius: 8rpx 8rpx 0 0;
}
.bar.zero { height: 4rpx; background: var(--line); }
.bar-date { font-size: 16rpx; color: var(--ink-3); margin-top: 8rpx; }

.rank-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--line); }
.rank-row:last-child { border-bottom: none; }
.rk-no {
  width: 44rpx; height: 44rpx;
  border-radius: 12rpx;
  background: #F1E9DE;
  color: var(--ink-2);
  display: flex; align-items: center; justify-content: center;
  font-weight: 800;
  margin-right: 20rpx;
}
.rk-no.hot { background: #F3E7D8; color: #B8783D; }
.rk-name { flex: 1; font-size: 27rpx; }
.rk-qty { color: var(--ink-2); font-size: 24rpx; }

.quick { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 8rpx; }
.qk {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: #FFF;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}

.qk { display: flex; align-items: center; }
.qk-ic { width: 36rpx; height: 36rpx; margin-right: 12rpx; flex-shrink: 0; }

