<view class="dash">
  <view class="dash-top">
    <view class="dash-head">
      <view>
        <view class="dash-title">经营看板</view>
        <view class="dash-date">{{overview.today}}</view>
      </view>
      <view class="dash-exit" bindtap="exit">退出</view>
    </view>
    <view class="big-card" wx:if="{{overview}}">
      <view class="bc-label">今日营业额</view>
      <view class="bc-num">¥{{overview.todaySales}}</view>
      <view class="bc-sub">饮品 ¥{{overview.todayDrink}} · 咖啡液 ¥{{overview.todayCoffee}} · 充值 ¥{{overview.todayRecharge}}</view>
    </view>
  </view>

  <view class="stat-grid" wx:if="{{overview}}">
    <view class="stat">
      <view class="s-num">{{overview.todayOrders}}</view>
      <view class="s-label">今日订单</view>
    </view>
    <view class="stat">
      <view class="s-num">{{overview.monthSales}}</view>
      <view class="s-label">本月销售额(¥)</view>
    </view>
    <view class="stat">
      <view class="s-num">{{overview.memberCount}}</view>
      <view class="s-label">会员总数</view>
    </view>
    <view class="stat">
      <view class="s-num">{{overview.pendingDelivery}}</view>
      <view class="s-label">待派送</view>
    </view>
    <view class="stat">
      <view class="s-num">{{overview.makingOrders}}</view>
      <view class="s-label">制作中饮品</view>
    </view>
    <view class="stat">
      <view class="s-num">{{overview.todayReservations}}</view>
      <view class="s-label">今日预订</view>
    </view>
  </view>

  <!-- 近14日趋势 -->
  <view class="card">
    <view class="card-title">近14日销售趋势</view>
    <view class="bars">
      <view class="bar-col" wx:for="{{trend}}" wx:key="date">
        <view class="bar" style="height:{{item.sales / maxSales * 120}}rpx;" wx:if="{{item.sales > 0}}"></view>
        <view class="bar zero" wx:else></view>
        <view class="bar-date">{{item.shortDate}}</view>
      </view>
    </view>
  </view>

  <!-- 畅销榜 -->
  <view class="card" wx:if="{{top}}">
    <view class="card-title">畅销 TOP 5</view>
    <view class="rank-row" wx:for="{{top.drinks}}" wx:key="name">
      <view class="rk-no {{index < 3 ? 'hot' : ''}}">{{index + 1}}</view>
      <view class="rk-name">{{item.name}}</view>
      <view class="rk-qty">{{item.quantity}} 杯</view>
    </view>
    <view class="rank-row" wx:for="{{top.coffees}}" wx:key="name">
      <view class="rk-no hot">☕</view>
      <view class="rk-name">{{item.name}}</view>
      <view class="rk-qty">{{item.quantity}} 瓶</view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick">
    <view class="qk" data-url="/pages/admin/reservations/reservations" bindtap="go">🚚 派送管理</view>
    <view class="qk" data-url="/pages/admin/orders/orders" bindtap="go">🧋 饮品订单</view>
    <view class="qk" data-url="/pages/admin/ledger/ledger" bindtap="go">📒 台账</view>
    <view class="qk" data-url="/pages/admin/products/products" bindtap="go">📦 商品管理</view>
    <view class="qk" data-url="/pages/admin/coupons/coupons" bindtap="go">🎟️ 优惠券</view>
    <view class="qk" data-url="/pages/admin/activities/activities" bindtap="go">🎉 活动海报</view>
    <view class="qk" data-url="/pages/admin/members/members" bindtap="go">👥 会员管理</view>
    <view class="qk" data-url="/pages/admin/settings/settings" bindtap="go">⚙️ 设置</view>
  </view>
</view>
