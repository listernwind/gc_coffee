<view class="page">
  <view wx:if="{{records.length}}">
    <view class="card record" wx:for="{{records}}" wx:key="id">
      <view class="rec-left">
        <view class="rec-type">{{item.typeLabel}}<text class="rec-remark"> {{item.remark}}</text></view>
        <view class="sub">{{item.createdAt}}</view>
      </view>
      <view class="rec-right {{item.positive ? 'ok' : ''}}">{{item.sign}}{{item.absAmount}}</view>
    </view>
  </view>
  <view class="empty" wx:else>
    <text class="icon">💰</text>
    <view>暂无余额流水</view>
  </view>
</view>
