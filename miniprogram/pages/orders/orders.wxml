<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{orders.length}}">
    <view class="card order-card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="o-head">
        <view class="o-no">单号 {{item.orderNo}}</view>
        <view class="badge {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="o-amount">
        <text class="sub">{{item.createdAt}}</text>
        <text class="price" style="font-size:34rpx;">¥{{item.payAmount}}</text>
      </view>
      <view class="o-foot" wx:if="{{item.status === 'PAID'}}">
        <view class="sub">取餐码</view>
        <view class="pickup">{{item.pickupCode}}</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <image class="icon ic ic-receipt" src="/assets/icons/receipt.png" />
    <view>暂无相关订单</view>
    <view class="sub" style="margin-top:8rpx;">去点一杯吧</view>
  </view>
</view>
