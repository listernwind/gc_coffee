.tabs {
  display: flex;
  background: #FFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
  border-radius: 999rpx;
}
.tab.active {
  background: var(--coffee);
  color: #FFF7EC;
  font-weight: 700;
}

.order-card { padding: 24rpx 28rpx; }
.o-head { display: flex; justify-content: space-between; align-items: center; }
.o-no { font-size: 24rpx; color: var(--ink-2); }
.o-amount {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 20rpx;
}
.pickup {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: var(--coffee);
  margin-left: 16rpx;
}
.o-foot { display: flex; align-items: center; margin-top: 8rpx; }
