.profile-page { padding: 0 28rpx 160rpx; }

.user-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #6F4E37, #4B3621);
  border-radius: 0 0 40rpx 40rpx;
  padding: 60rpx 32rpx 44rpx;
  color: #FFF7EC;
}
.uc-avatar {
  width: 110rpx; height: 110rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex; align-items: center; justify-content: center;
  font-size: 52rpx;
  margin-right: 24rpx;
}
.uc-name { font-size: 36rpx; font-weight: 800; }
.uc-tags { margin-top: 10rpx; }
.uc-tag {
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-right: 10rpx;
}
.uc-edit { margin-left: auto; font-size: 24rpx; opacity: 0.8; }

.more { color: var(--accent); font-size: 24rpx; }

.order-status { display: flex; }
.os-item { flex: 1; text-align: center; font-size: 22rpx; color: var(--ink-2); }
.os-emoji { font-size: 44rpx; display: block; margin-bottom: 8rpx; }

.menu-list { padding: 8rpx 28rpx; }
.mi {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.mi:last-child { border-bottom: none; }
.mi-icon { font-size: 38rpx; margin-right: 22rpx; }
.mi-text { flex: 1; font-size: 28rpx; }
.mi-arrow { color: var(--ink-3); font-size: 32rpx; }

.admin-entry {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #4B3621, #6F4E37);
  color: #FFF7EC;
}
.ae-icon { font-size: 44rpx; margin-right: 20rpx; }
.ae-text { flex: 1; }
.ae-text .sub { color: rgba(255, 247, 236, 0.65); font-size: 22rpx; }

.dev-zone {
  text-align: center;
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 40rpx;
}

.uc-avatar-img { width: 110rpx; height: 110rpx; border-radius: 50%; margin-right: 24rpx; }
.os-emoji { width: 44rpx; height: 44rpx; margin: 0 auto 8rpx; }
.mi-icon { width: 38rpx; height: 38rpx; }
.ae-icon { width: 44rpx; height: 44rpx; }

