.member-page { padding: calc(24rpx + env(safe-area-inset-top)) 28rpx 160rpx; }

.mcard {
  border-radius: 36rpx;
  padding: 44rpx 36rpx 36rpx;
  color: #FFF7EC;
  margin-top: 24rpx;
  box-shadow: 0 16rpx 40rpx rgba(75, 54, 33, 0.25);
}
.mc-top { display: flex; justify-content: space-between; align-items: center; }
.mc-level {
  display: inline-block;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}
.mc-name { font-size: 40rpx; font-weight: 800; margin-top: 14rpx; }
.mc-logo { font-size: 64rpx; opacity: 0.9; }
.mc-balance-row { display: flex; align-items: center; margin-top: 36rpx; }
.mc-balance { flex: 1; }
.mc-num { font-size: 52rpx; font-weight: 800; }
.mc-label { font-size: 22rpx; opacity: 0.7; }
.mc-points { flex: 1; }
.mc-recharge {
  background: linear-gradient(135deg, #D9A05B, #B8783D);
  color: #FFF;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 16rpx 44rpx;
  margin: 0;
}
.mc-recharge::after { border: none; }
.mc-progress { margin-top: 30rpx; }
.mc-pbar { height: 12rpx; background: rgba(255,255,255,0.2); border-radius: 999rpx; overflow: hidden; }
.mc-pbar-inner { height: 100%; background: linear-gradient(90deg, #F0C98A, #FFF); border-radius: 999rpx; }
.mc-ptip { font-size: 20rpx; opacity: 0.75; margin-top: 10rpx; }

.pkg-card { display: flex; justify-content: space-between; align-items: center; }
.pkg-left { display: flex; align-items: center; }
.pkg-emoji {
  width: 88rpx; height: 88rpx;
  background: #F3E7D8;
  border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  margin-right: 20rpx;
}
.pkg-name { font-weight: 700; }
.more { color: var(--accent); font-size: 26rpx; }

.quick-grid {
  display: flex;
  background: #FFF;
  border-radius: 28rpx;
  padding: 30rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(75, 54, 33, 0.06);
}
.qg-item { flex: 1; text-align: center; font-size: 24rpx; color: var(--ink-2); }
.qg-icon { font-size: 48rpx; display: block; margin-bottom: 10rpx; }
.qg-badge {
  display: inline-block;
  background: var(--accent-2);
  color: #FFF;
  border-radius: 999rpx;
  font-size: 18rpx;
  padding: 0 10rpx;
  margin-left: 4rpx;
}

.right-row { padding: 12rpx 0; font-size: 25rpx; color: var(--ink-2); }

.mc-logo { width: 64rpx; height: 64rpx; }
.qg-icon { width: 48rpx; height: 48rpx; margin: 0 auto 10rpx; }
.right-row { display: flex; align-items: flex-start; }
.right-ic { width: 30rpx; height: 30rpx; margin-right: 12rpx; flex-shrink: 0; margin-top: 4rpx; }

