.hero-banner {
  background: linear-gradient(135deg, #D9A05B, #B8783D);
  border-radius: 32rpx;
  padding: 44rpx 36rpx;
  color: #FFF;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(184, 120, 61, 0.3);
}
.hb-emoji { font-size: 64rpx; }
.hb-title { font-size: 40rpx; font-weight: 800; margin-top: 12rpx; }
.hb-sub { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.hb-period { font-size: 22rpx; opacity: 0.75; margin-top: 16rpx; }
.content-text {
  font-size: 28rpx;
  color: var(--ink);
  white-space: pre-wrap;
  line-height: 1.9;
}
