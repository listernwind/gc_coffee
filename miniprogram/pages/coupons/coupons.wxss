.tabs {
  display: flex;
  background: #FFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
  border-radius: 999rpx;
}
.tab.active { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.ticket {
  display: flex;
  background: linear-gradient(135deg, #6F4E37, #4B3621);
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  color: #FFF7EC;
}
.ticket.light { background: linear-gradient(135deg, #D9A05B, #B8783D); }
.ticket.dim { opacity: 0.5; }
.t-left {
  width: 220rpx;
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-right: 2rpx dashed rgba(255, 255, 255, 0.35);
  position: relative;
}
.t-value { font-size: 44rpx; font-weight: 800; }
.t-name { font-size: 24rpx; opacity: 0.85; margin-top: 6rpx; }
.t-redeem { font-size: 20rpx; margin-top: 8rpx; background: rgba(255,255,255,0.2); border-radius: 999rpx; padding: 4rpx 14rpx; align-self: flex-start; }
.t-right { flex: 1; padding: 26rpx 24rpx; }
.t-desc { font-size: 24rpx; opacity: 0.85; }
.t-expire { font-size: 20rpx; opacity: 0.6; margin-top: 8rpx; }
.t-source { font-size: 20rpx; opacity: 0.6; }
.t-actions { margin-top: 14rpx; display: flex; justify-content: flex-end; gap: 12rpx; }
