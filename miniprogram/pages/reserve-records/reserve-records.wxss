.head-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.more { font-size: 24rpx; color: var(--accent); }

.r-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.r-product { font-size: 30rpx; font-weight: 700; }
.r-qty { color: var(--ink-2); font-size: 26rpx; font-weight: 400; }
.r-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 25rpx;
}
.r-row .label { color: var(--ink-2); }
.r-row .value { max-width: 70%; text-align: right; }
