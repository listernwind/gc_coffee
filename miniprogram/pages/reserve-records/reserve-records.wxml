<view class="page">
  <view class="head-row">
    <view class="title">咖啡液预订记录</view>
    <view class="more" bindtap="goMonthly">月度详情 ›</view>
  </view>

  <view wx:if="{{records.length}}">
    <view class="card" wx:for="{{records}}" wx:key="id">
      <view class="r-head">
        <view class="r-product">{{item.productName}} <text class="r-qty">× {{item.quantity}}</text></view>
        <view class="badge {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>
      <view class="r-row"><text class="label">派送</text><text class="value">{{item.dateLabel}} {{item.timeSlot}}</text></view>
      <view class="r-row"><text class="label">地址</text><text class="value">{{item.address}}</text></view>
      <view class="r-row">
        <text class="label">支付</text>
        <text class="value">
          <text wx:if="{{item.packageUsed > 0}}" class="ok">额度抵 {{item.packageUsed}} 瓶</text>
          <text wx:if="{{item.packageUsed > 0 && item.payQuantity > 0}}"> + </text>
          <text wx:if="{{item.payQuantity > 0}}">¥{{item.amount}}</text>
        </text>
      </view>
      <view class="r-row" wx:if="{{item.status === 'PENDING'}}">
        <text class="label"></text>
        <button class="btn btn-sm btn-danger-ghost" data-id="{{item.id}}" bindtap="cancel">取消预订</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <text class="icon">📦</text>
    <view>还没有预订记录</view>
    <view class="sub" style="margin-top:8rpx;">今日预订，次日送到家</view>
  </view>
</view>
