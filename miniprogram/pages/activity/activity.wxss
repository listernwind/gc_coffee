.tabs {
  display: flex;
  background: #FFF;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.tab { flex: 1; text-align: center; padding: 16rpx 0; font-size: 26rpx; color: var(--ink-2); border-radius: 999rpx; }
.tab.active { background: var(--coffee); color: #FFF7EC; font-weight: 700; }

.act-card {
  background: #FFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(75, 54, 33, 0.06);
}
.act-banner {
  background: linear-gradient(135deg, #D9A05B, #B8783D);
  padding: 36rpx 32rpx;
  display: flex;
  align-items: center;
  color: #FFF;
  position: relative;
}
.ab-emoji { font-size: 56rpx; margin-right: 20rpx; }
.ab-title { flex: 1; font-size: 32rpx; font-weight: 800; }
.ab-status {
  background: rgba(255, 255, 255, 0.25);
  font-size: 20rpx;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}
.act-body { padding: 22rpx 32rpx; }
.act-sub { font-size: 26rpx; color: var(--ink); }
.act-period { font-size: 22rpx; color: var(--ink-3); margin-top: 8rpx; }

.poster-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(75, 54, 33, 0.05);
}
.pi-title { font-weight: 700; }
.pi-emoji { font-size: 56rpx; }
