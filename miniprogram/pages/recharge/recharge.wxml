<view class="page">
  <view class="card">
    <view class="title" style="margin-bottom:24rpx;">选择金额</view>
    <view class="amount-grid">
      <view
        wx:for="{{amounts}}"
        wx:key="*this"
        class="amount {{amount === item && !custom ? 'sel' : ''}}"
        data-amount="{{item}}"
        bindtap="select"
      >
        <view class="a-num">¥{{item}}</view>
        <view class="a-bonus" wx:if="{{item >= 300}}">送 ¥{{item / 10}}</view>
      </view>
    </view>
    <view class="form-item" style="margin-top:24rpx;">
      <text class="label">自定义金额</text>
      <input class="input" type="digit" placeholder="输入金额（元）" value="{{custom}}" bindinput="onCustom" />
    </view>
    <view class="notice-line">💡 开发期为模拟支付，接入微信支付后自动走真实收银</view>
  </view>

  <button class="btn btn-accent" disabled="{{submitting}}" bindtap="submit">立即充值 ¥{{amount || custom || 0}}</button>
</view>
