.overview {
  background: linear-gradient(150deg, #6F4E37 0%, #4B3621 100%);
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  color: #FFF7EC;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(75, 54, 33, 0.22);
}
.ov-head { display: flex; justify-content: space-between; align-items: center; }
.ov-month { font-size: 34rpx; font-weight: 800; letter-spacing: 2rpx; }
.ov-note { font-size: 22rpx; opacity: 0.7; }
.ov-cols { display: flex; margin-top: 28rpx; }
.ov-col { flex: 1; text-align: center; }
.ov-num { font-size: 44rpx; font-weight: 800; }
.ov-label { font-size: 22rpx; opacity: 0.7; margin-top: 4rpx; }
.ov-bar {
  height: 14rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  margin-top: 30rpx;
  overflow: hidden;
}
.ov-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #D9A05B, #F0C98A);
  border-radius: 999rpx;
}
.ov-tip { font-size: 20rpx; opacity: 0.65; text-align: center; margin-top: 14rpx; }

.pkg {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FBF4EA;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
}
.pkg-name { font-weight: 700; }
.pkg-remain { color: var(--accent); font-weight: 800; font-size: 30rpx; }

.r-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.r-row { display: flex; justify-content: space-between; padding: 6rpx 0; font-size: 24rpx; }
.r-row .label { color: var(--ink-2); }
